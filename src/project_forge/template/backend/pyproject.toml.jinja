[build-system]
requires = ["hatchling>=1.33,<2"]
build-backend = "hatchling.build"

[project]
name = "generated-backend"
version = "0.1.0"
requires-python = ">=3.11"
dependencies = [
  "fastapi[standard-no-fastapi-cloud-cli]>=0.162,<1",
  "psycopg[binary,pool]>=3.3.6,<4",
  "pydantic>=2.14.2,<3",
  "pydantic-settings>=2.16.2,<3",
  "typer>=0.27.3,<1",
]

[project.optional-dependencies]
auth = [
  "argon2-cffi>=25.1,<26",
  "email-validator>=2.3,<3",
]
evented = ["redis>=8.1,<9"]

[project.scripts]
"{{ command_name }}" = "app.cli:main"

[dependency-groups]
dev = [
  "httpx2>=2.16,<3",
  "mypy>=2.4.1,<3",
  "pip-audit>=2.10.1,<3",
  "pytest>=9.2,<10",
  "pytest-asyncio>=1.4.1,<2",
  "pytest-cov>=7.1,<8",
  "ruff>=0.17.3,<1",
]

[tool.hatch.build.targets.wheel]
packages = ["src/app"]

[tool.fastapi]
entrypoint = "app.main:app"

[tool.pytest.ini_options]
asyncio_mode = "auto"
asyncio_default_fixture_loop_scope = "function"
testpaths = ["tests"]

[tool.ruff]
target-version = "py311"
line-length = 100

[tool.ruff.lint]
select = ["E", "F", "I", "UP", "B", "SIM", "RUF"]

[tool.ruff.lint.isort]
known-first-party = ["app"]

[tool.mypy]
python_version = "3.11"
strict = true
packages = ["app"]
plugins = ["pydantic.mypy"]
