{% endif %}{% if evented %}def test_event_cli_covers_text_json_dry_run_and_retry_outputs(
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    pools: list[_ServicePool] = []
    retried_limits: list[int] = []

    def create_service_pool(_database_url: str) -> _ServicePool:
        pool = _ServicePool()
        pools.append(pool)
        return pool

    class _OutboxService:
        def __init__(self, _factory: UnitOfWorkFactory) -> None:
            pass

        async def status(self) -> OutboxStatus:
            return OutboxStatus(ready=1, deferred=2, failed=7, published=4)

        async def retry_failed(self, limit: int) -> tuple[UUID, ...]:
            retried_limits.append(limit)
            return (uuid4(), uuid4())

    monkeypatch.setattr(cli_module, "get_settings", lambda: Settings())
    monkeypatch.setattr(cli_module, "create_pool", create_service_pool)
    monkeypatch.setattr(cli_module, "OutboxService", _OutboxService)
    command = CliRunner()

    text_result = command.invoke(cli_module.app, ["events", "status"])
    assert text_result.exit_code == 0
    assert "ready=1" in text_result.stdout
    assert "published=4" in text_result.stdout
    json_result = command.invoke(cli_module.app, ["events", "status", "--json"])
    assert json_result.exit_code == 0
    assert '"failed": 7' in json_result.stdout
    dry_result = command.invoke(
        cli_module.app, ["events", "retry-failed", "--dry-run", "--limit", "3"]
    )
    assert dry_result.exit_code == 0
    assert "would_retry=3" in dry_result.stdout
    retry_result = command.invoke(
        cli_module.app, ["events", "retry-failed", "--limit", "2"]
    )
    assert retry_result.exit_code == 0
    assert "retried=2" in retry_result.stdout
    assert retried_limits == [2]
    assert all(pool.opened and pool.closed for pool in pools)


