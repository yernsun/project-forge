async def test_auth_items_migration_preserves_legacy_rows_and_enforces_new_writes() -> None:
    database_url = os.getenv("TEST_DATABASE_URL")
    if not database_url:
        pytest.skip("set TEST_DATABASE_URL to a dedicated PostgreSQL database")

    schema_name = f"auth_items_upgrade_{uuid4().hex}"
    pool = create_pool(database_url)
    await pool.open()
    try:
        async with pool.connection() as connection:
            try:
                await connection.execute(
                    sql.SQL("CREATE SCHEMA {}").format(sql.Identifier(schema_name))
                )
                await connection.commit()
                await connection.execute(
                    sql.SQL("SET search_path TO {}").format(sql.Identifier(schema_name))
                )
                await connection.commit()

                base_migrations = (CORE, ITEMS, AUTH, AUTH_SECURITY)
                assert await MigrationRunner(connection, base_migrations).up() == (
                    "0001_core",
                    "0010_items",
                    "0020_auth",
                    "0021_auth_security",
                )
                now = utc_now()
                null_item_id = uuid4()
                orphan_item_id = uuid4()
                orphan_workspace_id = uuid4()
                for item_id, workspace_id, name in (
                    (null_item_id, None, "legacy-null"),
                    (orphan_item_id, orphan_workspace_id, "legacy-orphan"),
                ):
                    await connection.execute(
                        sql.SQL(
                            "INSERT INTO items ("
                            "item_id, workspace_id, name, description, status, version, "
                            "created_at, updated_at"
                            ") VALUES ("
                            "%(item_id)s, %(workspace_id)s, %(name)s, NULL, 'ACTIVE', 1, "
                            "%(now)s, %(now)s)"
                        ),
                        {
                            "item_id": item_id,
                            "workspace_id": workspace_id,
                            "name": name,
                            "now": now,
                        },
                    )
                await connection.commit()

                assert await MigrationRunner(
                    connection, (*base_migrations, AUTH_ITEMS)
                ).up() == ("0022_auth_items",)
                cursor = await connection.execute(
                    sql.SQL(
                        "SELECT convalidated FROM pg_constraint "
                        "WHERE conrelid = 'items'::regclass AND conname = 'fk_items_workspace'"
                    )
                )
                constraint = await cursor.fetchone()
                assert constraint is not None
                assert constraint["convalidated"] is False

                with pytest.raises(ForeignKeyViolation):
                    async with connection.transaction():
                        await connection.execute(
                            sql.SQL(
                                "INSERT INTO items ("
                                "item_id, workspace_id, name, description, status, version, "
                                "created_at, updated_at"
                                ") VALUES ("
                                "%(item_id)s, %(workspace_id)s, 'new-orphan', NULL, "
                                "'ACTIVE', 1, %(now)s, %(now)s)"
                            ),
                            {
                                "item_id": uuid4(),
                                "workspace_id": uuid4(),
                                "now": now,
                            },
                        )

                await connection.execute(
                    sql.SQL(
                        "INSERT INTO workspaces (workspace_id, name, created_at) "
                        "VALUES (%(workspace_id)s, 'repaired legacy workspace', %(now)s)"
                    ),
                    {"workspace_id": orphan_workspace_id, "now": now},
                )
                await connection.execute(
                    sql.SQL("ALTER TABLE items VALIDATE CONSTRAINT fk_items_workspace")
                )
                cursor = await connection.execute(
                    sql.SQL(
                        "SELECT convalidated FROM pg_constraint "
                        "WHERE conrelid = 'items'::regclass AND conname = 'fk_items_workspace'"
                    )
                )
                validated = await cursor.fetchone()
                assert validated is not None
                assert validated["convalidated"] is True
                cursor = await connection.execute(
                    sql.SQL(
                        "SELECT workspace_id FROM items WHERE item_id = %(item_id)s"
                    ),
                    {"item_id": null_item_id},
                )
                null_row = await cursor.fetchone()
                assert null_row is not None
                assert null_row["workspace_id"] is None
            finally:
                await connection.rollback()
                await connection.execute(sql.SQL("SET search_path TO public"))
                await connection.execute(
                    sql.SQL("DROP SCHEMA IF EXISTS {} CASCADE").format(
                        sql.Identifier(schema_name)
                    )
                )
                await connection.commit()
    finally:
        await pool.close()
