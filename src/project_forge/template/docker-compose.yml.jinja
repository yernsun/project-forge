name: {{ project_slug }}

services:
{% if profile != 'frontend' %}  db:
    image: postgres:16-alpine
    restart: unless-stopped
    environment:
      POSTGRES_DB: app
      POSTGRES_USER: app
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?set POSTGRES_PASSWORD}
    volumes:
      - postgres-data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U app -d app"]
      interval: 5s
      timeout: 3s
      retries: 20

{% if evented %}  redis:
    image: redis:7-alpine
    restart: unless-stopped
    command: ["redis-server", "--appendonly", "yes"]
    volumes:
      - redis-data:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 3s
      retries: 20

{% endif %}  migrate:
    build:
      context: ./backend
    environment: &backend-env
      DATABASE_URL: postgresql://app:${POSTGRES_PASSWORD}@db:5432/app
      APP_ENV: production
      APP_ALLOWED_ORIGINS: ${APP_ALLOWED_ORIGINS:?set APP_ALLOWED_ORIGINS}
      APP_SESSION_COOKIE_SECURE: "true"
{% if evented %}      REDIS_URL: redis://redis:6379/0
{% endif %}    command: ["app", "migrate", "up"]
    depends_on:
      db:
        condition: service_healthy

  api:
    build:
      context: ./backend
    restart: unless-stopped
    environment: *backend-env
    depends_on:
      migrate:
        condition: service_completed_successfully
{% if evented %}      redis:
        condition: service_healthy
{% endif %}    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/live')"]
      interval: 10s
      timeout: 3s
      retries: 10

{% if evented %}  event-relay:
    build:
      context: ./backend
    restart: unless-stopped
    environment: *backend-env
    command: ["python", "-m", "app.events.worker", "relay"]
    depends_on:
      migrate:
        condition: service_completed_successfully
      redis:
        condition: service_healthy

{% endif %}{% endif %}{% if profile != 'backend' %}  web:
    build:
      context: ./frontend
    restart: unless-stopped

{% endif %}  gateway:
    image: nginx:1.27-alpine
    restart: unless-stopped
    ports:
      - "8080:8080"
    volumes:
      - ./infra/nginx/default.conf:/etc/nginx/conf.d/default.conf:ro
{% if profile != 'frontend' %}    depends_on:
      api:
        condition: service_healthy
{% elif profile != 'backend' %}    depends_on:
      web:
        condition: service_started
{% endif %}    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "-", "http://127.0.0.1:8080/healthz"]
      interval: 10s
      timeout: 3s
      retries: 10

volumes:
{% if profile != 'frontend' %}  postgres-data:
{% if evented %}  redis-data:
{% endif %}{% endif %}
