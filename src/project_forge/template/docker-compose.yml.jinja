name: {{ project_slug }}

services:
{% if profile != 'frontend' %}  db:
    image: postgres:16-alpine
    restart: unless-stopped
    environment:
      POSTGRES_DB: app
      POSTGRES_USER: app
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?set POSTGRES_PASSWORD}
    volumes:
      - postgres-data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U app -d app"]
      interval: 5s
      timeout: 3s
      retries: 20

{% if evented %}  redis:
    image: redis:7-alpine
    restart: unless-stopped
    command: ["redis-server", "--appendonly", "yes"]
    volumes:
      - redis-data:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 3s
      retries: 20

{% endif %}  migrate:
    build:
      context: ./backend
    environment: &backend-env
      DATABASE_URL: ${DATABASE_URL:?set DATABASE_URL with percent-encoded credentials}
      APP_ENV: production
{% if auth %}      APP_ALLOWED_ORIGINS: ${APP_ALLOWED_ORIGINS:?set APP_ALLOWED_ORIGINS}
      APP_SESSION_COOKIE_SECURE: "true"
      APP_AUTH_RATE_LIMIT_SECRET: ${APP_AUTH_RATE_LIMIT_SECRET:?set APP_AUTH_RATE_LIMIT_SECRET to at least 32 random bytes}
      APP_SIGNUP_ENABLED: ${APP_SIGNUP_ENABLED:-false}
      FORWARDED_ALLOW_IPS: ${FORWARDED_ALLOW_IPS:?set trusted gateway and proxy IPs or CIDRs; never use *}
{% endif %}{% if evented %}      REDIS_URL: redis://redis:6379/0
{% endif %}    command: ["app", "migrate", "up"]
    depends_on:
      db:
        condition: service_healthy

  api:
    build:
      context: ./backend
    restart: unless-stopped
    environment: *backend-env
    depends_on:
      migrate:
        condition: service_completed_successfully
{% if evented %}      redis:
        condition: service_healthy
{% endif %}    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/live')"]
      interval: 10s
      timeout: 3s
      retries: 10

{% if evented %}  event-relay:
    build:
      context: ./backend
    restart: unless-stopped
    environment: *backend-env
    command: ["python", "-m", "app.events.worker"]
    depends_on:
      migrate:
        condition: service_completed_successfully
      redis:
        condition: service_healthy

{% endif %}{% endif %}{% if profile != 'backend' %}  web:
    build:
      context: ./frontend
      args:
        VITE_API_BASE_URL: ""
    restart: unless-stopped

{% endif %}  gateway:
    image: nginx:1.27-alpine
    restart: unless-stopped
    environment:
      NGINX_ENVSUBST_FILTER: ^API_UPSTREAM$
{% if profile != 'frontend' %}      API_UPSTREAM: http://api:8000
{% elif sample %}      API_UPSTREAM: ${FRONTEND_API_UPSTREAM:?set FRONTEND_API_UPSTREAM for the sample API}
{% endif %}    extra_hosts:
      - "host.docker.internal:host-gateway"
    ports:
      - "${APP_BIND_HOST:-127.0.0.1}:8080:80"
    volumes:
      - ./infra/nginx/default.conf:/etc/nginx/templates/default.conf.template:ro
{% if profile == 'fullstack' %}    depends_on:
      api:
        condition: service_healthy
      web:
        condition: service_started
{% elif profile == 'backend' %}    depends_on:
      api:
        condition: service_healthy
{% else %}    depends_on:
      web:
        condition: service_started
{% endif %}    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "-", "http://127.0.0.1:80/healthz"]
      interval: 10s
      timeout: 3s
      retries: 10

{% if profile != 'frontend' %}volumes:
  postgres-data:
{% if evented %}  redis-data:
{% endif %}{% endif %}
