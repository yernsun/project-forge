# Development Compose overrides. Copy to .env.dev and pass --env-file .env.dev.
# Active values are loopback-safe. For LAN UI access, change only the frontend bind/port
# and replace the documentation-only 172.20.0.10 address with this host's private address.
{% if profile != 'backend' %}DEV_FRONTEND_BIND_HOST=127.0.0.1
DEV_FRONTEND_PORT=5173
# LAN example: DEV_FRONTEND_BIND_HOST=0.0.0.0
# LAN example: DEV_FRONTEND_PORT=8173
{% endif %}{% if profile != 'frontend' %}DEV_API_BIND_HOST=127.0.0.1
DEV_API_PORT=8000
DEV_DB_BIND_HOST=127.0.0.1
DEV_DB_PORT=5432
{% if evented %}DEV_REDIS_BIND_HOST=127.0.0.1
DEV_REDIS_PORT=6379
{% endif %}{% endif %}{% if auth %}# This maps to APP_ALLOWED_ORIGINS inside the API container.
DEV_APP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# LAN example: DEV_APP_ALLOWED_ORIGINS=http://localhost:8173,http://127.0.0.1:8173,http://172.20.0.10:8173
# Empty is fail-safe. Set only after inspecting the immediate development proxy/network.
DEV_FORWARDED_ALLOW_IPS=
DEV_SIGNUP_ENABLED=true
{% endif %}
