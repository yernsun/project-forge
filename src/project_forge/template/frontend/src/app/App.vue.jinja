<script setup lang="ts">
{% if auth or not sample %}import Button from 'primevue/button'
{% endif %}{% if auth %}import Message from 'primevue/message'
import ProgressSpinner from 'primevue/progressspinner'
{% endif %}import { usePrimeVue } from 'primevue/config'
import { useI18n } from 'vue-i18n'
{% if auth %}
import AuthPanel from '@/features/auth/AuthPanel.vue'
import { useSessionState } from '@/features/auth/session'
import WorkspaceSwitcher from '@/features/auth/WorkspaceSwitcher.vue'
{% if sample %}
import { useWorkspaceStore } from '@/features/auth/workspace'
{% endif %}
{% endif %}{% if sample %}import ItemsPage from '@/features/items/ItemsPage.vue'
{% endif %}import { supportedLocales, type AppLocale } from '@/shared/i18n'
import { useLocaleStore } from '@/shared/stores/locale'

const { t } = useI18n()
const localeStore = useLocaleStore()
const primeVue = usePrimeVue()
{% if auth %}const { sessionQuery, session, state: authState } = useSessionState()
{% if sample %}
const workspaceStore = useWorkspaceStore()
{% endif %}
{% endif %}
function changeLocale(event: Event): void {
  const next = (event.target as HTMLSelectElement).value as AppLocale
  localeStore.setLocale(next, primeVue)
}
</script>

<template>
  <div class="app-shell">
    <header class="topbar">
      <div>
        <p class="eyebrow">{{ project_name | e }}</p>
        <h1 v-text="t('app.title')" />
        <p class="subtitle" v-text="t('app.subtitle')" />
      </div>
      <label class="locale-control">
        <span v-text="t('app.language')" />
        <select :value="localeStore.locale" @change="changeLocale">
          <option
            v-for="locale in supportedLocales"
            :key="locale"
            :value="locale"
            v-text="t(`locales.${locale}`)"
          />
        </select>
      </label>
    </header>
    <main>
{% if auth %}      <section v-if="sessionQuery.isError.value" class="content-card auth-status" role="alert">
        <Message severity="error" :closable="false"><span v-text="t('auth.errors.session_failed')" /></Message>
        <Button
          icon="pi pi-refresh"
          :label="t('app.retry')"
          @click="sessionQuery.refetch()"
        />
      </section>
      <section v-else-if="authState === 'loading'" class="content-card auth-status" aria-live="polite">
        <ProgressSpinner class="auth-spinner" stroke-width="5" />
        <p v-text="t('auth.restoringSession')" />
      </section>
      <AuthPanel v-else-if="authState === 'guest'" />
      <template v-else-if="session">
        <WorkspaceSwitcher :session="session" />
{% if sample %}        <ItemsPage :workspace-id="workspaceStore.workspaceId" />
{% else %}        <section class="hero-card">
          <span class="status-dot" aria-hidden="true" />
          <p v-text="t('app.ready')" />
          <Button :label="t('app.ready')" icon="pi pi-check" disabled />
        </section>
{% endif %}      </template>
{% else %}{% if sample %}      <ItemsPage />
{% else %}      <section class="hero-card">
        <span class="status-dot" aria-hidden="true" />
        <p v-text="t('app.ready')" />
        <Button :label="t('app.ready')" icon="pi pi-check" disabled />
      </section>
{% endif %}{% endif %}    </main>
  </div>
</template>
