export interface components {
  schemas: {
    Item: {
      itemId: string
      workspaceId: string | null
      name: string
      description: string | null
      status: 'ACTIVE' | 'ARCHIVED'
      version: number
      createdAt: string
      updatedAt: string
    }
    ItemListResponse: { items: components['schemas']['Item'][] }
    CreateItemRequest: { name: string; description?: string | null }
  }
}

export interface paths {
{% if auth %}  '/api/v1/workspaces/{workspaceId}/items': {
{% else %}  '/api/v1/items': {
{% endif %}    parameters: { query?: never; header?: never; path?: never; cookie?: never }
    get: operations['listItems']
    post: operations['createItem']
  }
}

export interface operations {
  listItems: {
    parameters: {
      query?: { limit?: number; offset?: number; sort?: string }
      header?: never
{% if auth %}      path: { workspaceId: string }
{% else %}      path?: never
{% endif %}      cookie?: never
    }
    requestBody?: never
    responses: {
      200: {
        headers: { [name: string]: unknown }
        content: { 'application/json': components['schemas']['ItemListResponse'] }
      }
    }
  }
  createItem: {
    parameters: {
      query?: never
      header?: never
{% if auth %}      path: { workspaceId: string }
{% else %}      path?: never
{% endif %}      cookie?: never
    }
    requestBody: {
      content: { 'application/json': components['schemas']['CreateItemRequest'] }
    }
    responses: {
      201: {
        headers: { [name: string]: unknown }
        content: { 'application/json': components['schemas']['Item'] }
      }
    }
  }
}
