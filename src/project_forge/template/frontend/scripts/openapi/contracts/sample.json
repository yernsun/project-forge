{
  "components": {
    "schemas": {
      "CreateItemRequest": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "anyOf": [
              {
                "maxLength": 2000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional details",
            "title": "Description"
          },
          "name": {
            "description": "Display name",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "CreateItemRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "description": "Current health state",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "ItemListResponse": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "description": "Current page",
            "items": {
              "$ref": "#/components/schemas/ItemResponse"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "ItemListResponse",
        "type": "object"
      },
      "ItemResponse": {
        "additionalProperties": false,
        "properties": {
          "createdAt": {
            "description": "UTC creation timestamp",
            "format": "date-time",
            "title": "Createdat",
            "type": "string"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional details",
            "title": "Description"
          },
          "itemId": {
            "description": "Stable item ID",
            "format": "uuid",
            "title": "Itemid",
            "type": "string"
          },
          "name": {
            "description": "Display name",
            "title": "Name",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/ItemStatus",
            "description": "Lifecycle status"
          },
          "updatedAt": {
            "description": "UTC last-update timestamp",
            "format": "date-time",
            "title": "Updatedat",
            "type": "string"
          },
          "version": {
            "description": "Optimistic-lock version",
            "title": "Version",
            "type": "integer"
          },
          "workspaceId": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Owning workspace when auth is enabled",
            "title": "Workspaceid"
          }
        },
        "required": [
          "itemId",
          "workspaceId",
          "name",
          "description",
          "status",
          "version",
          "createdAt",
          "updatedAt"
        ],
        "title": "ItemResponse",
        "type": "object"
      },
      "ItemSort": {
        "enum": [
          "createdAtDesc",
          "createdAtAsc",
          "nameAsc",
          "nameDesc"
        ],
        "title": "ItemSort",
        "type": "string"
      },
      "ItemStatus": {
        "enum": [
          "ACTIVE",
          "ARCHIVED"
        ],
        "title": "ItemStatus",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Auth Matrix API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/items": {
      "get": {
        "operationId": "listItems",
        "parameters": [
          {
            "description": "Name contains",
            "in": "query",
            "name": "name",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 200,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Name contains",
              "title": "Name"
            }
          },
          {
            "description": "Exact lifecycle status",
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/ItemStatus"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Exact lifecycle status",
              "title": "Status"
            }
          },
          {
            "description": "Filter SQL NULL descriptions",
            "in": "query",
            "name": "descriptionIsNull",
            "required": false,
            "schema": {
              "default": false,
              "description": "Filter SQL NULL descriptions",
              "title": "Descriptionisnull",
              "type": "boolean"
            }
          },
          {
            "description": "Whitelisted sort mode",
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/ItemSort",
              "default": "createdAtDesc",
              "description": "Whitelisted sort mode"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 200,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemListResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Items",
        "tags": [
          "items"
        ]
      },
      "post": {
        "operationId": "createItem",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateItemRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Item",
        "tags": [
          "items"
        ]
      }
    },
    "/api/v1/items/{itemId}": {
      "get": {
        "operationId": "getItem",
        "parameters": [
          {
            "description": "Item ID",
            "in": "path",
            "name": "itemId",
            "required": true,
            "schema": {
              "description": "Item ID",
              "format": "uuid",
              "title": "Itemid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Item",
        "tags": [
          "items"
        ]
      }
    },
    "/health/live": {
      "get": {
        "operationId": "liveness_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "readiness_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Readiness",
        "tags": [
          "health"
        ]
      }
    }
  }
}
