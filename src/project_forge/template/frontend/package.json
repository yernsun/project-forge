{
  "name": "generated-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13 <23 || >=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run api:check && npm run i18n:check && vue-tsc -b && vite build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "i18n:check": "node scripts/check-i18n.mjs",
    "api:generate": "node scripts/generate-api.mjs",
    "api:check": "node scripts/generate-api.mjs --check"
  },
  "dependencies": {
    "@primeuix/themes": "^3.1.0",
    "@tanstack/vue-query": "^5.107.1",
    "@vue/devtools-api": "^8.2.1",
    "openapi-fetch": "^0.17.0",
    "pinia": "^4.1.0",
    "primeicons": "^8.0.2",
    "primevue": "^5.0.4",
    "vue": "^3.5.45",
    "vue-i18n": "^11.4.18"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@tsconfig/node22": "^22.0.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/test-utils": "~2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "minimatch": "^11.0.3",
    "glob": "^14.0.3"
  }
}
