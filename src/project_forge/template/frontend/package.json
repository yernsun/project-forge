{
  "name": "generated-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13 <23 || >=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run api:check && npm run i18n:check && vue-tsc -b && vite build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "i18n:check": "node scripts/check-i18n.mjs",
    "api:generate": "node scripts/generate-api.mjs",
    "api:check": "node scripts/generate-api.mjs --check"
  },
  "dependencies": {
    "@primeuix/themes": "^3.0.1",
    "@tanstack/vue-query": "^5.104.1",
    "openapi-fetch": "^0.17.0",
    "pinia": "^4.0.3",
    "primeicons": "^8.0.2",
    "primevue": "^5.0.2",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@tsconfig/node22": "^22.0.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.3",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "openapi-typescript": "^7.9.1",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  }
}
