# Production Compose values. Copy to .env and replace every change-me value.
{% if profile != 'frontend' %}# POSTGRES_PASSWORD is raw; percent-encode its value in DATABASE_URL.
POSTGRES_PASSWORD=change-me-database-password
DATABASE_URL=postgresql://app:change-me-percent-encoded-database-password@db:5432/app
{% endif %}{% if auth %}# Documentation-only private origin; replace with the actual browser origin.
APP_ALLOWED_ORIGINS=https://172.20.0.10:8443
APP_AUTH_RATE_LIMIT_SECRET=
APP_SIGNUP_ENABLED=false
# Comma-separated IPs/CIDRs for the immediate gateway and every trusted proxy hop. Never use *.
FORWARDED_ALLOW_IPS=
{% endif %}APP_BIND_HOST=127.0.0.1
{% if profile != 'frontend' %}APP_LOG_LEVEL=INFO
APP_LOG_MAX_BYTES=10485760
APP_LOG_BACKUP_COUNT=5
APP_LOG_SQL_ENABLED=true
APP_LOG_SQL_SLOW_MS=200
{% endif %}
{% if profile == 'frontend' and sample %}
# External API used by the frontend-only sample.
FRONTEND_API_UPSTREAM=http://host.docker.internal:8000
FRONTEND_API_PROXY_TARGET=http://host.docker.internal:8000
{% endif %}
